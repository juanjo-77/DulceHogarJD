{
  "expo": {
    "name": "Dulce Hogar JD",
    "slug": "dulce-hogar-jd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dulcehogar",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFBF9",
    "ios": {
      "bundleIdentifier": "com.dulcehogarjd.app"
    },
    "android": {
      "package": "com.dulcehogarjd.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8DDE4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Dulce Hogar JD",
      "themeColor": "#FFFBF9",
      "backgroundColor": "#FFFBF9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dulce Hogar JD usa tus fotos para mostrar cómo se ve cada producto.",
          "cameraPermission": "Dulce Hogar JD usa la cámara para tomarle foto a los productos."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
